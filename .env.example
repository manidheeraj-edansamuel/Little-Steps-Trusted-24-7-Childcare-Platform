# PostgreSQL connection string.
# Replace YOUR_PASSWORD with the password for the `postgres` user,
# and make sure a database named `littlesteps` exists.
#
# Create the DB once with:
#   psql -U postgres -h localhost -c "CREATE DATABASE littlesteps;"
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/littlesteps?schema=public"

# Secret used to sign session JWTs. Change this to any long random string.
AUTH_SECRET="dev-change-me-please-use-a-long-random-string"
